# VocaForge Environment Configuration Example
# Copy this file to .env.local:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Required for project storage, agent records, simulations, and observability.
# Default local Docker setup (docker compose up -d db):
DATABASE_URL=postgresql://vocaforge:vocaforge@localhost:5434/vocaforge
DATABASE_SSL=disable

# -----------------------------------------------------------------------------
# ElevenLabs API Integration
# -----------------------------------------------------------------------------
# Required for synchronizing voice agents, running live voice tests, and remote simulations.
# Obtain your key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# Optional overrides for models:
# ELEVENLABS_AGENT_LLM=gemini-1.5-flash
# ELEVENLABS_AGENT_TTS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_PREVIEW_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# AI Configuration Generation & Refinement
# -----------------------------------------------------------------------------
# Used for AI-assisted agent config, persona synthesis, and failure fix proposals.
# Supported providers: "groq" or "anthropic"
# Option A: Groq (Recommended - Fast & Cost-effective)
GENERATION_PROVIDER=groq
GROQ_API_KEY=
GENERATION_MODEL=llama-3.3-70b-versatile
GENERATION_BASE_URL=https://api.groq.com/openai

# Option B: Anthropic Claude
# GENERATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# GENERATION_MODEL=claude-3-5-sonnet-20241022
# GENERATION_BASE_URL=https://api.anthropic.com

GENERATION_TIMEOUT_MS=60000
PROMPT_MAX_CHARS=4000

# -----------------------------------------------------------------------------
# Application Access & Security
# -----------------------------------------------------------------------------
# Secret token for HTTP Basic authentication gate (username: anything, password: token).
# If empty and VOCAFORGE_ALLOW_UNAUTHENTICATED=false in production, the app returns 503.
VOCAFORGE_ACCESS_TOKEN=
VOCAFORGE_ALLOW_UNAUTHENTICATED=true

# -----------------------------------------------------------------------------
# Observability & Logging
# -----------------------------------------------------------------------------
# Levels: debug | info | warn | error
LOG_LEVEL=info
