{
  "name": "vocaforge",
  "version": "0.1.0",
  "private": true,
  "description": "VocaForge: deploy virtual customers, discover real problems, launch with confidence.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "elevenlabs:check": "tsx scripts/elevenlabs-check.ts",
    "elevenlabs:smoke": "tsx scripts/elevenlabs-smoke.ts",
    "elevenlabs:cleanup": "tsx scripts/elevenlabs-cleanup.ts",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "phase2:smoke": "tsx scripts/phase2-smoke.ts",
    "generation:check": "tsx scripts/generation-check.ts",
    "demo:setup": "tsx scripts/setup-demo.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.20.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^30.1.3",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
